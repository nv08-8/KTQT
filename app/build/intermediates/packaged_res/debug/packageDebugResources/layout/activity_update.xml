<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/updateProfile"
    android:background="@color/colorPrimary">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/form"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="100dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:orientation="vertical"
        android:paddingTop="50dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        app:layout_constraintTop_toTopOf="@id/updateProfile"
        app:layout_constraintBottom_toBottomOf="@id/updateProfile"
        app:layout_constraintLeft_toLeftOf="@id/updateProfile"
        app:layout_constraintRight_toRightOf="@id/updateProfile"
        android:background="@color/colorCardBackground">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="18sp"
            android:paddingLeft="3dp"/>
        <EditText
            android:id="@+id/newName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="New name"
            android:inputType="textPersonName"
            android:textSize="15sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:paddingLeft="3dp"/>
        <EditText
            android:id="@+id/newMail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="New email"
            android:inputType="textEmailAddress"
            android:textSize="15sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:paddingLeft="3dp"/>
        <EditText
            android:id="@+id/newPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="New phone"
            android:inputType="phone"
            android:textSize="15sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Avatar"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:paddingLeft="3dp"/>
        <EditText
            android:id="@+id/newAva"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="New Avatar Url"
            android:textSize="15sp"/>
        <Button
            android:id="@+id/btnUpdateProfile"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Update"
            android:layout_marginLeft="95dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>